# Backend Flask - Produccion (VM)
SECRET_KEY=replace-with-a-strong-random-secret

# Usa DATABASE_URL o variables MYSQL_*
DATABASE_URL=mysql+pymysql://climaguru_app:replace-password@127.0.0.1:3306/climaguru?ssl_disabled=true

# Si prefieres variables separadas, comenta DATABASE_URL y usa esto:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=climaguru_app
# MYSQL_PASSWORD=replace-password
# MYSQL_DATABASE=climaguru
# MYSQL_SSL_DISABLED=true

# CORS en produccion (ajusta dominio real)
CORS_ORIGINS=https://app.climaguru.com
