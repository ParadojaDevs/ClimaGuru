{
  "info": {
    "name": "ClimaGuru Backend - Auth y CRUD Usuarios",
    "description": "Coleccion para login + CRUD de usuarios con pruebas automaticas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Health status ok', function () {",
              "  pm.expect(data.status).to.eql('ok');",
              "});",
              "pm.test('Tiempo de respuesta aceptable', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Login retorna token', function () {",
              "  pm.expect(data).to.have.property('token');",
              "  pm.expect(data.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.environment.set('auth_token', data.token);",
              "pm.test('Usuario en respuesta', function () {",
              "  pm.expect(data).to.have.property('user');",
              "  pm.expect(data.user).to.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/users",
          "host": ["{{base_url}}"],
          "path": ["users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Usuario creado con id', function () {",
              "  pm.expect(data).to.have.property('id');",
              "  pm.expect(data.username).to.eql(pm.environment.get('test_username'));",
              "});",
              "pm.environment.set('test_user_id', String(data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": ["{{base_url}}"],
          "path": ["users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Respuesta es arreglo', function () {",
              "  pm.expect(data).to.be.an('array');",
              "});",
              "const createdId = Number(pm.environment.get('test_user_id'));",
              "const found = data.some(u => u.id === createdId);",
              "pm.test('Usuario creado aparece en listado', function () {",
              "  pm.expect(found).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{updated_username}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/users/{{test_user_id}}",
          "host": ["{{base_url}}"],
          "path": ["users", "{{test_user_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Username actualizado', function () {",
              "  pm.expect(data.username).to.eql(pm.environment.get('updated_username'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Delete",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/{{test_user_id}}",
          "host": ["{{base_url}}"],
          "path": ["users", "{{test_user_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Mensaje de eliminacion', function () {",
              "  pm.expect(data.message).to.eql('usuario eliminado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Users - Verify Deleted",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": ["{{base_url}}"],
          "path": ["users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "const deletedId = Number(pm.environment.get('test_user_id'));",
              "const stillExists = data.some(u => u.id === deletedId);",
              "pm.test('Usuario eliminado ya no aparece', function () {",
              "  pm.expect(stillExists).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "admin123" },
    { "key": "test_username", "value": "postman_user_001" },
    { "key": "test_password", "value": "postman_pass_001" },
    { "key": "updated_username", "value": "postman_user_001_updated" },
    { "key": "auth_token", "value": "" },
    { "key": "test_user_id", "value": "" }
  ]
}
