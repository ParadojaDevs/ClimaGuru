# Backend Flask - Local + Tailscale hacia VM MySQL
SECRET_KEY=local-dev-secret

# IP Tailscale de la VM MySQL (100.x.y.z)
MYSQL_HOST=100.64.0.10
MYSQL_PORT=3306
MYSQL_USER=climaguru_app
MYSQL_PASSWORD=replace-password
MYSQL_DATABASE=climaguru
MYSQL_SSL_DISABLED=true

# Si prefieres una sola variable:
# DATABASE_URL=mysql+pymysql://climaguru_app:replace-password@100.64.0.10:3306/climaguru?ssl_disabled=true

CORS_ORIGINS=http://localhost:5173
