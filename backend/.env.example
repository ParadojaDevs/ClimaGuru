SECRET_KEY=change-this-in-production

# Opcion 1: URL completa de SQLAlchemy
# DATABASE_URL=mysql+pymysql://climaguru_app:password@127.0.0.1:3306/climaguru?ssl_disabled=true

# Opcion 2: Variables separadas (se usan para construir DATABASE_URL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=climaguru_app
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=climaguru
MYSQL_SSL_DISABLED=true

# Frontend permitido por CORS (separar multiples por coma)
CORS_ORIGINS=http://localhost:5173
